    "petUnlocked":   { "value": "unlocked",         "file": "game.js", "pattern": "S\\.pet\\.(unlocked)" },
    "petType":       { "value": "type",             "file": "game.js", "pattern": "S\\.pet\\.(type) ===" },
    "petLevel":      { "value": "level",            "file": "game.js", "pattern": "getPetMaxStat\\(S\\.pet\\.(level)\\)" },
    "branchBought":  { "value": "bought",           "file": "game.js", "pattern": "S\\.branches\\[[\\w.]+\\]\\.(bought)" },
    "branchClosed":  { "value": "closed",           "file": "game.js", "pattern": "S\\.branches\\[[\\w.]+\\]\\.(closed)" },
    "branchLevel":   { "value": "level",            "file": "game.js", "pattern": "S\\.branches\\[[\\w.]+\\]\\.(level)" },
    "evId":          { "value": "id",        "file": "game.js", "pattern": "return !!e&&e\\.([\\w$]+)===id\\}" },
    "starsScore":    { "value": "s",         "file": "game.js", "pattern": "isSpecialRecipeGuest\\)return \\{([\\w$]+):5,[\\w$]+:'special_recipe'\\}" },
    "starsWhy":      { "value": "why",       "file": "game.js", "pattern": "isSpecialRecipeGuest\\)return \\{[\\w$]+:5,([\\w$]+):'special_recipe'\\}" },
    "locId":         { "value": "id",        "file": "game.js", "pattern": "\\.find\\(l => l\\.([\\w$]+) === curId\\)" },
    "branchId":      { "value": "id",        "file": "game.js", "pattern": "S\\.branches\\[b\\.([\\w$]+)\\]" },
    "evName":        { "value": "n",         "file": "game.js", "pattern": "hot:\\{([\\w$]+):'Trời nóng'" },
    "evDesc":        { "value": "d",         "file": "game.js", "pattern": "\\[e\\.id\\]\\.([\\w$]+)\\.replace\\('%'" },
    "upgName":       { "value": "name",      "file": "game.js", "pattern": "Hạng mục: \\$\\{cfg\\.([\\w$]+)\\} \\(Cấp" },
    "upgBonus":      { "value": "curBonus",  "file": "game.js", "pattern": "Hiệu quả hiện tại: <b>\\$\\{cfg\\.([\\w$]+)\\(lv\\)\\}" },
    "locIcon":       { "value": "icon",      "file": "game.js", "pattern": "vnmap-hero-title\">\\$\\{curLoc\\.([\\w$]+)\\}" },
    "locName":       { "value": "name",      "file": "game.js", "pattern": "vnmap-hero-title\">\\$\\{curLoc\\.[\\w$]+\\} \\$\\{esc\\(curLoc\\.([\\w$]+)\\)\\}" },
    "locRegion":     { "value": "region",    "file": "game.js", "pattern": "vnmap-hero-region\">\\(\\$\\{esc\\(curLoc\\.([\\w$]+)\\)\\}" },
    "locDefault":    { "value": "isDefault", "file": "game.js", "pattern": "curLoc\\.id === 'default' \\|\\| curLoc\\.([\\w$]+)\\)" },
    "branchName":    { "value": "name",      "file": "game.js" },
    "branchIcon":    { "value": "icon",      "file": "game.js" },
    "branchCost":    { "value": "buyCost",   "file": "game.js" },
    "branchRent":    { "value": "dailyRent", "file": "game.js" },
    "taxExpires":    { "value": "expiresAt", "file": "game.js", "pattern": "S\\.tax\\.([\\w$]+) = now \\+ [\\w$]+;" },
    "cfgThiefDay":   { "value": "thiefDay",   "file": "game.js", "pattern": "if\\(S\\.day<CFG\\.([\\w$]+)&&S\\.money>CFG\\.[\\w$]+\\)[\\w$]+\\(\\)" },
    "cfgThiefMoney": { "value": "thiefMoney", "file": "game.js", "pattern": "if\\(S\\.day<CFG\\.[\\w$]+&&S\\.money>CFG\\.([\\w$]+)\\)[\\w$]+\\(\\)" },
    "cfgStartMoney": { "value": "startMoney", "file": "game.js", "pattern": "const cap=CFG\\.([\\w$]+)\\+S\\.day\\*\\d+;" },
    "seedName":      { "value": "name",      "file": "garden.js" },
    "seedIcon":      { "value": "icon",      "file": "garden.js" },
    "seedDays":      { "value": "days",      "file": "garden.js" }
  },

  "shapes": {
    "review": {
      "value": { "s": "$stars", "t": "$text", "k": "$key", "d": "$day", "o": false, "n": "$name", "f": "😊", "tg": "⭐ Khách quen", "b": "tra", "fl": null, "tp": ["tran"], "ch": false, "sz": "M" },
      "pattern": "S\\.reviews\\.unshift\\(\\{s:5,t:txt,k:'party_'"
    },
    "branch": {
      "value": { "bought": true, "level": 1, "openedDay": "$day", "closed": false },
      "pattern": "S\\.branches\\[bid\\] = \\{ bought: true, level: 1, openedDay: S\\.day, closed: false \\}"
    },
    "stockBatch": {
      "value": { "q": 0, "exp": 0 },
      "pattern": "st\\.stock\\[k\\]\\.push\\(\\{q,exp\\}\\)"
    },
    "event": {
      "value": { "id": "$id", "k": "$item" },
      "pattern": "const evIs=id=>\\{const e=ev\\(\\);return !!e&&e\\.id===id\\}"
    },
    "taxPaid": {
      "value": { "paidAt": "$now", "expiresAt": "$expires", "rate": "$rate" },
      "pattern": "S\\.tax\\.paidAt = now;\\s*S\\.tax\\.expiresAt = now \\+ [\\w$]+;[^\\n]*\\n\\s*S\\.tax\\.rate = pct / 100;"
    }
  },

